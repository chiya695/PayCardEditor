# Keep the legacy Xposed entry point and hooks.
-keep class com.luoshui.paycardeditor.hook.ModuleMain { public <init>(); *; }
-keep class * implements de.robv.android.xposed.IXposedHookLoadPackage { *; }
-keep class * extends de.robv.android.xposed.XC_MethodHook { *; }

# Third-party libs that resolve members reflectively at runtime.
-keep class org.luckypray.dexkit.** { *; }
-keep class org.lsposed.** { *; }
-keep class com.yalantis.ucrop.** { *; }
